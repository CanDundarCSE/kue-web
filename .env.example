# Base URL of the Kue .NET API, called from Next.js server-side route handlers.
# This is the backend's origin, not the /api/v1/auth prefix — the routes append it.
# Match the profile you run: `dotnet run --launch-profile http` uses http://localhost:5148,
# `dotnet run` (https profile) uses https://localhost:7230.
KUE_API_URL=http://localhost:5148

# Public twin of KUE_API_URL so the browser can open the SignalR hub directly.
# Keep the same value as KUE_API_URL above.
NEXT_PUBLIC_KUE_API_URL=http://localhost:5148
